# Copy to .env on your PC (never commit .env). Market Insights never places orders.
ENABLE_ORDER_PLACEMENT=false
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
# true ONLY for active Dhan Web-issued tokens eligible for renewal
DHAN_WEB_GENERATED_TOKEN=false
INSIGHTS_PORT=8765
# Empty means first 30 Dhan-mapped eligible F&O cash underlyings. Configure your own shortlist.
INSIGHTS_WATCHLIST=
INSIGHTS_MAX_SYMBOLS=30
# Full absolute paths to user-reviewed files (for holiday and sector confirmation).
INSIGHTS_HOLIDAY_FILE=
INSIGHTS_SECTOR_MAP_FILE=
# Optional user-supplied licensed, dated delivery JSON (never scrape)
INSIGHTS_LICENSED_DELIVERY_FILE=
# Optional separate research-data storage directory
# BHARATSIGNAL_INSIGHTS_HOME=
